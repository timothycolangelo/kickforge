{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CPM_SOURCE_CACHE": "${sourceDir}/.cache/cpm"
      }
    },
    {
      "name": "win-vs2022",
      "displayName": "Windows, Visual Studio 2022",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "win-vs2019",
      "displayName": "Windows, Visual Studio 2019",
      "inherits": "base",
      "generator": "Visual Studio 16 2019",
      "architecture": "x64",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "win-ninja",
      "displayName": "Windows, Ninja + MSVC (run from a VS developer shell)",
      "inherits": "base",
      "generator": "Ninja Multi-Config",
      "cacheVariables": { "CMAKE_C_COMPILER": "cl", "CMAKE_CXX_COMPILER": "cl" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "mac-xcode",
      "displayName": "macOS, Xcode (universal)",
      "inherits": "base",
      "generator": "Xcode",
      "cacheVariables": { "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    }
  ],
  "buildPresets": [
    { "name": "win-vs2022-release", "configurePreset": "win-vs2022", "configuration": "Release" },
    { "name": "win-vs2019-release", "configurePreset": "win-vs2019", "configuration": "Release" },
    { "name": "win-ninja-release", "configurePreset": "win-ninja", "configuration": "Release" },
    { "name": "mac-xcode-release", "configurePreset": "mac-xcode", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "win-vs2022-release", "configurePreset": "win-vs2022", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "win-vs2019-release", "configurePreset": "win-vs2019", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "win-ninja-release", "configurePreset": "win-ninja", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "mac-xcode-release", "configurePreset": "mac-xcode", "configuration": "Release", "output": { "outputOnFailure": true } }
  ]
}
